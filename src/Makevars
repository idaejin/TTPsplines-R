CXX_STD = CXX17
FLIBS =

# OpenMP for P2b.3 fused Gram reduction.
# Prefer R Makeconf flags when present; on macOS Apple Clang use Homebrew libomp.
OPENMP_CFLAGS =
OPENMP_LIBS =

ifneq ($(SHLIB_OPENMP_CXXFLAGS),)
  OPENMP_CFLAGS = $(SHLIB_OPENMP_CXXFLAGS)
  OPENMP_LIBS = $(SHLIB_OPENMP_CFLAGS)
else ifeq ($(shell uname -s),Darwin)
  LIBOMP_PREFIX := $(shell brew --prefix libomp 2>/dev/null)
  ifneq ($(LIBOMP_PREFIX),)
    OPENMP_CFLAGS = -Xpreprocessor -fopenmp -I$(LIBOMP_PREFIX)/include
    OPENMP_LIBS = -L$(LIBOMP_PREFIX)/lib -lomp
  endif
else
  # Generic GCC / Clang with OpenMP
  OPENMP_CFLAGS = -fopenmp
  OPENMP_LIBS = -fopenmp
endif

PKG_CXXFLAGS = $(OPENMP_CFLAGS)
PKG_LIBS = $(OPENMP_LIBS) $(LAPACK_LIBS) $(BLAS_LIBS)
